// openclaw.patch-broker-fabric-off.json5
// Single-key kill switch for the broker-fabric Telegram bot.
//
// Effect: bot @bt_broker_fabric_bot stops receiving any messages -> agent
// `broker-fabric` is never invoked -> zero tokens spent on this project.
//
// What is preserved (intentionally — for reversibility):
//   * agent `broker-fabric` in agents.list
//   * route binding `telegram/broker-fabric -> broker-fabric`
//   * botToken env ref (BROKER_FABRIC_BOT_TOKEN stays in ~/.openclaw/.env)
//   * allowFrom list
//   * workspace ~/.openclaw/workspace-broker-fabric/
//   * webhook route `broker-fabric-ci`
//   * repo /Users/boris/github.com/broker-fabric
//
// To re-enable later: apply the inverse patch (enabled: true) or run
// `openclaw config set channels.telegram.accounts.broker-fabric.enabled true`.
//
// Apply:
//   openclaw config patch --file ./openclaw.patch-broker-fabric-off.json5 --dry-run
//   openclaw config patch --file ./openclaw.patch-broker-fabric-off.json5
//   openclaw gateway restart   # if hot-reload doesn't pick up channels change

{
  channels: {
    telegram: {
      accounts: {
        "broker-fabric": {
          enabled: false
        }
      }
    }
  }
}
