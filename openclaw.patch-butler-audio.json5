// openclaw.patch-butler-audio.json5
// Enables voice/audio message transcription via OpenAI Whisper API.
// Without this, voice messages to the butler bot fail silently ("Something went wrong").
//
// Prerequisites:
//   1. skills.entries.openai-whisper-api.apiKey must be set in openclaw.json
//      (already in place — added during initial openclaw doctor wizard)
//   2. Script /Users/boris/.openclaw/workspace-butler/bin/transcribe-via-openai
//      must exist and be executable.
//
// Apply:
//   openclaw config patch --file ./openclaw.patch-butler-audio.json5 --dry-run
//   openclaw config patch --file ./openclaw.patch-butler-audio.json5
//   pkill -9 -f 'dist/index.*gateway'  # launchd respawns
//
// Lesson: L-2026-05-26-4 (audio.transcription is TOP-LEVEL, not under tools)

{
  audio: {
    transcription: {
      command: [
        "/Users/boris/.openclaw/workspace-butler/bin/transcribe-via-openai",
        "{{MediaPath}}"
      ],
      timeoutSeconds: 90
    }
  }
}
