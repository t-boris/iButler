// DERIVED from openclaw.patch-bamberg-news.json5 (2026-07-19): Boris chose to
// run Bamberg News WITHOUT the Telegram control bot for now. This variant adds
// only the bamberg-news agent (no telegram account, no bamberg binding).
// When the bot token appears in ~/.openclaw/.env, apply the FULL patch instead.
{
  agents: {
    list: [
      {
        id: "tetyana-dyck",
        name: "TetyanaDyck",
        description: "FamilyBuilder.io / Tetyana-Dyck-Web pipeline agent (t-boris/Tetyana-Dyck-Web). Non-technical primary user (Tanya), trilingual site en/ru/uk, Firebase deploy to https://familybuilder.io.",
        workspace: "/Users/boris/.openclaw/workspace-tetyana-dyck",
        model: { primary: "anthropic/claude-sonnet-5", fallbacks: [] },
        models: { "anthropic/claude-sonnet-5": {} },
        bootstrapMaxChars: 24000,
        runtime: {
          type: "acp",
          acp: {
            agent: "claude",
            backend: "acpx",
            mode: "persistent",
            cwd: "/Users/boris/.openclaw/workspace-tetyana-dyck"
          }
        }
      },
      {
        id: "butler",
        name: "AIButler",
        description: "Boris's personal AI Butler — project control, task memory, Obsidian KB, project docs, deep research, news intelligence, proactive goal pursuit.",
        workspace: "/Users/boris/.openclaw/workspace-butler",
        model: { primary: "openai/gpt-5.5", fallbacks: [] },
        models: { "anthropic/claude-opus-4-8": {} },
        runtime: {
          type: "acp",
          acp: {
            agent: "codex",
            backend: "acpx",
            mode: "persistent",
            cwd: "/Users/boris/.openclaw/workspace-butler"
          }
        }
      },
      {
        id: "bamberg-news",
        name: "BambergNews",
        description: "Isolated factual Russian-language Bamberg/Bavaria news video service for a dedicated YouTube channel.",
        workspace: "/Users/boris/.openclaw/workspace-bamberg-news",
        // Switched codex -> claude 2026-07-20: codex acpx runtime died mid-run 4x in one day.
        model: { primary: "anthropic/claude-sonnet-5", fallbacks: [] },
        models: { "anthropic/claude-sonnet-5": {} },
        runtime: {
          type: "acp",
          acp: {
            agent: "claude",
            backend: "acpx",
            mode: "persistent",
            cwd: "/Users/boris/.openclaw/workspace-bamberg-news"
          }
        }
      }
    ]
  },

  bindings: [
    {
      type: "route",
      agentId: "tetyana-dyck",
      comment: "tetyana-dyck bot → tetyana-dyck agent (FamilyBuilder.io)",
      match: { channel: "telegram", accountId: "tetyana-dyck" }
    },
    {
      type: "route",
      agentId: "butler",
      comment: "butler bot → butler agent (Boris's personal AI)",
      match: { channel: "telegram", accountId: "butler" }
    },
    {
      type: "route",
      agentId: "butler",
      comment: "WhatsApp → butler (INGEST-ONLY: buffer via butler-inbox, NEVER reply — see AGENTS.md hard rule)",
      match: { channel: "whatsapp", accountId: "default" }
    }
  ]
}
