// openclaw.patch-butler.json5
// Additive patch: registers the `butler` agent and its workspace, WITHOUT
// touching the existing `tetyana-dyck` agent, route, telegram account, or
// webhook. Per Boris directive: "не сломай существующие workspaces".
//
// PREREQUISITES — must be done BEFORE applying:
//   1. (optional) Create a dedicated Telegram bot for the butler via @BotFather.
//      Save its token to ~/.openclaw/.env as BUTLER_BOT_TOKEN. If you skip this,
//      the butler will only be reachable via the default account (8443482001)
//      after you add a binding for it manually.
//   2. Stop the gateway if running:    pgrep -fl openclaw  →  kill <pid>
//
// Apply (dry-run first, ALWAYS):
//   openclaw config patch --file ./openclaw.patch-butler.json5 --dry-run
// Review the diff. Then for real:
//   openclaw config patch --file ./openclaw.patch-butler.json5
//   openclaw gateway run
//
// Merge semantics (per `openclaw config patch --help`):
//   * objects merge recursively
//   * arrays/scalars REPLACE — but `agents.list` and `bindings` are handled
//     below by overriding with the FULL merged list. KEEP tetyana-dyck entries
//     before adding butler.
//
// Reversal: openclaw config set channels.telegram.accounts.butler.enabled false
//           && openclaw gateway restart

{
  // ─────────────────────────────────────────────────────────────
  // 1. Add the butler agent — additive entry in agents.list
  //
  //    NOTE: arrays replace per patch semantics. The CURRENT agents.list
  //    contains only `tetyana-dyck`. This patch lists BOTH so the result
  //    keeps tetyana-dyck intact and adds butler. If you ever apply this
  //    after adding more agents, edit this list to include them.
  // ─────────────────────────────────────────────────────────────
  agents: {
    list: [
      // KEEP existing tetyana-dyck entry verbatim (mirrored from current config).
      {
        id: "tetyana-dyck",
        name: "TetyanaDyck",
        description: "FamilyBuilder.io / Tetyana-Dyck-Web pipeline agent (t-boris/Tetyana-Dyck-Web). Non-technical primary user (Tanya), trilingual site en/ru/uk, Firebase deploy to https://familybuilder.io.",
        workspace: "/Users/boris/.openclaw/workspace-tetyana-dyck",
        model: { primary: "anthropic/claude-sonnet-5", fallbacks: [] },
        models: {
          "anthropic/claude-sonnet-5": { agentRuntime: { id: "claude-cli" } }
        }
      },
      // NEW butler agent.
      // NOTE: per-agent `subagents` is not allowed by openclaw schema; the global
      // `agents.defaults.subagents` (from existing config) applies. Tweak there if
      // you need different concurrency for the butler later.
      {
        id: "butler",
        name: "AIButler",
        description: "Boris's personal AI Butler — project control, task memory, Obsidian KB, project docs, deep research, news intelligence, proactive goal pursuit. See docs/AI-Butler-Architecture.md.",
        workspace: "/Users/boris/.openclaw/workspace-butler",
        model: { primary: "anthropic/claude-sonnet-5", fallbacks: [] },
        models: {
          "anthropic/claude-sonnet-5": { agentRuntime: { id: "claude-cli" } },
          "anthropic/claude-opus-4-8":   { agentRuntime: { id: "claude-cli" } },
          "anthropic/claude-haiku-4-5":  { agentRuntime: { id: "claude-cli" } }
        }
      }
    ]
  },

  // ─────────────────────────────────────────────────────────────
  // 2. Telegram account for the butler.
  //
  //    Disabled by default — set `enabled: true` only after you've created
  //    the bot in BotFather and added BUTLER_BOT_TOKEN to ~/.openclaw/.env.
  //
  //    OPTIONAL: if you'd rather reuse the default account, delete this whole
  //    block and add a `bindings[]` entry binding `accountId: "default"` plus
  //    `from: [<your TG id>]` to `agentId: "butler"`.
  // ─────────────────────────────────────────────────────────────
  channels: {
    telegram: {
      accounts: {
        butler: {
          enabled: false,  // FLIP to true after BotFather + env var set
          botToken: {
            source: "env",
            provider: "default",
            id: "BUTLER_BOT_TOKEN"
          },
          dmPolicy: "allowlist",
          allowFrom: [253483520],  // Boris's TG id (confirmed in tetyana-dyck allowFrom)
          groupPolicy: "disabled"  // butler is personal-only
        }
      }
    }
  },

  // ─────────────────────────────────────────────────────────────
  // 3. Bindings — keep both existing AND add butler.
  //    Per patch semantics, arrays REPLACE; mirror current bindings here.
  // ─────────────────────────────────────────────────────────────
  bindings: [
    {
      type: "route",
      agentId: "tetyana-dyck",
      comment: "tetyana-dyck bot → tetyana-dyck agent (FamilyBuilder.io)",
      match: { channel: "telegram", accountId: "tetyana-dyck" }
    },
    {
      type: "route",
      agentId: "butler",
      comment: "butler bot → butler agent (Boris's personal AI)",
      match: { channel: "telegram", accountId: "butler" }
    }
  ],

  // ─────────────────────────────────────────────────────────────
  // 4. Webhooks — preserve tetyana-dyck-ci, no new butler webhook yet.
  //    (Webhooks added in Phase 2 when project-status skill is wired up.)
  // ─────────────────────────────────────────────────────────────
  plugins: {
    entries: {
      webhooks: {
        config: {
          routes: {
            "tetyana-dyck-ci": {
              path: "/plugins/webhooks/tetyana-dyck-ci",
              sessionKey: "agent:tetyana-dyck:main",
              description: "FamilyBuilder.io CI deploy callback (Firebase Hosting + Functions)",
              secret: { source: "env", provider: "default", id: "TETYANA_DYCK_CI_SECRET" }
            }
          }
        }
      }
    }
  }
}
