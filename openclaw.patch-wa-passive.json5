// WhatsApp receives into the inbox without a model; socket guards are required.
{
  "bindings": [
    {
      "type": "route",
      "agentId": "tetyana-dyck",
      "comment": "tetyana-dyck bot → tetyana-dyck agent (FamilyBuilder.io)",
      "match": {
        "channel": "telegram",
        "accountId": "tetyana-dyck"
      }
    },
    {
      "type": "route",
      "agentId": "butler",
      "comment": "butler bot → butler agent (Boris's personal AI)",
      "match": {
        "channel": "telegram",
        "accountId": "butler"
      }
    }
  ],
  "session": {
    "sendPolicy": {
      "default": "allow",
      "rules": [
        {
          "action": "deny",
          "match": {
            "channel": "whatsapp"
          }
        }
      ]
    }
  },
  "channels": {
    "whatsapp": {
      "enabled": false,
      "sendReadReceipts": false,
      "debounceMs": 0
    }
  }
}
